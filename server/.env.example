# Orbit backend config — copy to .env and fill in.

PORT=4000

# Plaid (sandbox for the demo) — https://dashboard.plaid.com
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# Batching threshold (USDC) before converting + depositing on-chain
THRESHOLD_USD=10

# Auth — Google OAuth client id (same value the frontend uses) for verifying
# ID tokens server-side. Get it from https://console.cloud.google.com credentials.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Secret used to sign session tokens. MUST be a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated list of origins allowed to call this API (the frontend URL).
# In production include your Vercel domain (scheme + host, no trailing slash).
CORS_ORIGINS=http://localhost:3000,https://orbit-five-topaz.vercel.app

# --- Hosting (Railway/Render/Fly/VPS) ---
# Funder/authority secret key for on-chain ops. base58 string OR a JSON byte array.
# On a host there's no ~/.config/solana/id.json, so set this. Local dev can leave it blank.
FUNDER_SECRET_KEY=
# Directory for persistent files (SQLite db + saved mint). Point at a mounted volume,
# e.g. /data on Railway. Leave blank for local dev (files sit next to the source).
DATA_DIR=
