# Orbit backend config — copy to .env and fill in.

PORT=4000

# Plaid (sandbox for the demo) — https://dashboard.plaid.com
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# Batching threshold (USDC) before converting + depositing on-chain
THRESHOLD_USD=10

# Auth — Google OAuth client id (same value the frontend uses) for verifying
# ID tokens server-side. Get it from https://console.cloud.google.com credentials.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Secret used to sign session tokens. MUST be a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated list of origins allowed to call this API (the frontend URL).
CORS_ORIGINS=http://localhost:3000
