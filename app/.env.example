# Orbit frontend (Next.js) — copy to .env.local for local dev, or set these in your
# host's env (e.g. Vercel). All NEXT_PUBLIC_* values are baked in at build time, so
# redeploy after changing them.

# Base URL of the Orbit backend API (no trailing slash).
# Local: http://localhost:4000 · Production: your deployed API origin.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public origin of this site — drives canonical, Open Graph / share-preview, and sitemap URLs.
# MUST be the real deployed domain or share thumbnails won't resolve.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth client id for "Sign in with Google" (same id the server verifies against).
# Leave blank to fall back to the demo account only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Solana RPC endpoint the wallet/vault reads from (devnet by default).
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
